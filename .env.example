# Bot authentication / access control (applies to all commands)
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_USER_ID=user_id_1,user_id_2
# Optional: allow non-private chats (group/supergroup/channel) by chat ID.
# If unset, bot only executes commands in private chats.
AUTHORIZED_CHAT_ID=

# Optional command allowlist:
# If empty/unset, all commands in ALL_COMMAND_CLASSES are enabled.
# /start is always enabled.
ENABLED_COMMANDS=status,emby_status,adguard_status,network_tests,example,docker_status

# /network_tests
GOHOME_API_URL=http://localhost:8080/status
GOHOME_TIMEOUT_SECONDS=10

# Services permitted for /service and /logs (required for those commands).
BOTTY_SERVICE_ALLOWLIST=botty,nginx

# Telegram long-poll timeout in seconds (higher = fewer poll requests/log noise).
TELEGRAM_POLL_TIMEOUT_SECONDS=300

# TOTP confirmation for state-changing commands:
#   /reboot confirm <totp>
#   /upgrade_bot confirm <totp>
#   /docker_restart <container> <totp>
#   /wol <mac> <totp>
#   /service <name> <action> <totp>
#   /logs <service> <totp>
#   /ping <host> <totp>
#   /check_updates <totp>
# Generate a secret with:
# python3 - <<'PY'
# import secrets, base64
# print(base64.b32encode(secrets.token_bytes(20)).decode().rstrip("="))
# PY
TOTP_SECRET=
# Allowed clock drift in 30-second steps (default: 1 => +/- 30 seconds).
TOTP_WINDOW_STEPS=1

# /emby_status
EMBY_DATA_PATH=/mnt/embydata
MEDIA_PATH=/mnt/media

# Optional: used for privileged commands that require sudo password auth.
# Leave empty if using passwordless sudo.
BOTTY_SUDO_PASSWORD=
