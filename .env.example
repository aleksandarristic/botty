# Bot authentication / access control (applies to all commands)
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_USER_ID=user_id_1,user_id_2

# Optional command allowlist:
# If empty/unset, all commands in ALL_COMMAND_CLASSES are enabled.
# /start is always enabled.
ENABLED_COMMANDS=status,emby_status,adguard_status,network_tests,example,docker_status

# /network_tests
GOHOME_API_URL=http://localhost:8080/status
GOHOME_TIMEOUT_SECONDS=10

# /emby_status
EMBY_DATA_PATH=/mnt/embydata
MEDIA_PATH=/mnt/media
